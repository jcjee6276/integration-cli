{
  "name": "@jcjeon/integration-cli",
  "version": "0.2.1",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local web workspace for Claude Code, Gemini CLI, and Codex tasks",
  "bin": {
    "jccli": "./packages/cli/dist/index.js"
  },
  "files": [
    "README.md",
    "packages/cli/dist",
    "apps/server/dist",
    "apps/web/.next",
    "!apps/web/.next/cache",
    "apps/web/public",
    "apps/web/package.json",
    "apps/web/next.config.ts"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepack": "turbo run build",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/typeorm": "^11.0.1",
    "@scalar/nestjs-api-reference": "^1.1.16",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^13.1.0",
    "next": "16.2.4",
    "node-pty": "^1.1.0",
    "ora": "^8.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.29",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
