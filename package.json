{
  "name": "ji",
  "version": "0.1.0",
  "private": false,
  "description": "Local web workspace for Claude Code, Gemini CLI, and Codex tasks",
  "bin": {
    "jccli": "./packages/cli/dist/index.js"
  },
  "files": [
    ".gitignore",
    ".npmignore",
    ".prettierignore",
    ".prettierrc",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "apps/server/.gitignore",
    "apps/server/README.md",
    "apps/server/eslint.config.mjs",
    "apps/server/nest-cli.json",
    "apps/server/package.json",
    "apps/server/scripts",
    "apps/server/src",
    "apps/server/test",
    "apps/server/tsconfig.build.json",
    "apps/server/tsconfig.json",
    "apps/web/.gitignore",
    "apps/web/AGENTS.md",
    "apps/web/CLAUDE.md",
    "apps/web/README.md",
    "apps/web/eslint.config.mjs",
    "apps/web/next-env.d.ts",
    "apps/web/next.config.ts",
    "apps/web/package.json",
    "apps/web/postcss.config.mjs",
    "apps/web/public",
    "apps/web/src",
    "apps/web/tsconfig.json",
    "apps/web/vitest.config.ts",
    "apps/web/vitest.setup.ts",
    "packages/cli/dist",
    "packages/cli/package.json",
    "packages/cli/src",
    "packages/cli/tsconfig.json",
    "packages/eslint-config",
    "packages/typescript-config/base.json",
    "packages/typescript-config/nestjs.json",
    "packages/typescript-config/nextjs.json",
    "packages/typescript-config/package.json",
    "turbo.json"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepack": "npm run build --workspace @ji/cli",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
